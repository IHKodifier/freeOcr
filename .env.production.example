# freeOCR.me Production Environment Configuration (.env.production)
# Copy to .env in production deployment environment (e.g. GCP Secret Manager / Cloud Run env vars)

# Application Environment
ENVIRONMENT=production

# Database Configuration (PostgreSQL / Cloud SQL recommended for production)
DATABASE_URL=sqlite:////tmp/freeocr_prod.db

# External Serverless Redis (Upstash Redis TLS for scale-to-zero 24h persistence)
# Costs $0.00 when idle; persists email download links and output PDFs across container shutdowns
REDIS_URL=rediss://default:your_upstash_password@us1-test-12345.upstash.io:6379
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=5.0
REDIS_RETRY_ON_TIMEOUT=true
REDIS_SSL_CERT_REQS=none

# Ephemeral Processing Limits
FREE_TIER_MAX_FILE_MB=50
MAX_STACK_FILE_MB=900

# Telemetry & Monitoring
GA4_MEASUREMENT_ID=G-FFTTL86J86
SENTRY_DSN=

# Google Ad Manager (GAM / AdX) Configuration
GAM_NETWORK_CODE=1234567
GAM_LEADERBOARD_AD_UNIT=/1234567/freeocr_leaderboard_728x90

# Transactional Email Delivery (Resend API)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=delivery@freeocr.me
API_BASE_URL=https://freeocr.me


# Cloud Run Scale-to-Zero Configuration Reference
# gcloud run deploy freeocr-api \
#   --image gcr.io/PROJECT_ID/freeocr-backend:latest \
#   --region us-central1 \
#   --platform managed \
#   --min-instances 0 \
#   --max-instances 5 \
#   --memory 2Gi \
#   --cpu 2 \
#   --allow-unauthenticated
